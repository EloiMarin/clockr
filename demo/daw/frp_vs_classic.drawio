  <diagram id="mailbox-daw" name="3 — Mailbox DAW (non-FRP)">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p4-0" />
        <mxCell id="p4-1" parent="p4-0" />
        <mxCell id="p4-title" value="3rd example — Mailbox DAW (non-FRP, from scratch): one owner of time, everything else is messages" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333;" vertex="1" parent="p4-1">
          <mxGeometry x="30" y="8" width="1340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-s-ui" value="UI thread — proposes" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p4-1">
          <mxGeometry x="30" y="48" width="280" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p4-s-ch" value="Shared protocol (written once)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p4-1">
          <mxGeometry x="340" y="48" width="220" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p4-s-audio" value="Audio thread — owns time" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p4-1">
          <mxGeometry x="590" y="48" width="380" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p4-s-fix" value="Each Classic failure → fixed" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p4-1">
          <mxGeometry x="1000" y="48" width="370" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p4-u1" value="Widgets build Commands — Play / Pause / Seek{beat} / SetLoop{…} / SetTempo / SetGain" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p4-1">
          <mxGeometry x="42" y="84" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4-u2" value="Gestures build whole structs — a drag is SetLoop{start,end,on}, never two writes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p4-1">
          <mxGeometry x="42" y="168" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4-u3" value="Cursor + meters render the latest Status only — no transport reads from UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p4-1">
          <mxGeometry x="42" y="252" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4-u4" value="ackSeq compare — UI knows exactly what took effect; un-acked intent shows as pending" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p4-1">
          <mxGeometry x="42" y="336" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p4-u5" value="No locks, no atomics in UI code — the queue is the only shared object" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p4-1">
          <mxGeometry x="42" y="420" width="256" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p4-q1" value="Command queue (SPSC) — every intent is a seq-numbered immutable Command" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="350" y="84" width="200" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p4-q2" value="Drained at block start only — never mid-block; order is seq order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="350" y="208" width="200" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p4-q3" value="Status triple buffer — whole Status published; UI reads latest, never torn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="350" y="332" width="200" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p4-a1" value="TransportState: plain struct, one owner, zero locks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="600" y="84" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p4-a2" value="Block start: drain queue → reduce in seq order → new state" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="600" y="158" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p4-a3" value="Render: clock → transport → sequencer → voices → mixer, all functions of (state, BlockDesc)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="600" y="238" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p4-a4" value="Publish Status{ackSeq, playhead, meters} whole to the triple buffer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="600" y="318" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p4-a5" value="The reducer is pure: (state, commands, block) → (state, outputs) — unit-tested, no threads, no sleeps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="600" y="398" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4-f1" value="✓ Torn pair — SetLoop is one immutable value, applied at a block boundary only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="1010" y="84" width="350" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p4-f2" value="✓ Drain order — seq numbers, reduced in order; seek-while-paused pinned by a unit test" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="1010" y="180" width="350" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p4-f3" value="✓ Intent vs time — audio owns time; UI proposes; ackSeq confirms effect" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="1010" y="276" width="350" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p4-f4" value="✓ Cursor — snapshots carry ackSeq; quiet audio means held cursor, for free" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="1010" y="372" width="350" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p4-f5" value="✓ Tests — reducer is pure; queue + buffer tested once, generically" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p4-1">
          <mxGeometry x="1010" y="468" width="350" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p4-m1" value="The convergence is the point: immutable messages, single ownership, boundary application — the disciplines FRP formalizes, rediscovered by hand. The Tracktion column was never the only non-FRP option." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="30" y="710" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-m2" value="Residual gap: each new message is still hand code (no generic latest/queued with laws); ordering lives in review, not types; production time comes from the soundcard while tests use a manual driver." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="690" y="710" width="680" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-e1" value="dispatch" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="p4-1" source="p4-u1" target="p4-q1" exitX="1" exitY="0.5" exitDx="0" exitDy="0" entryX="0" entryY="0.3" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e2" value="dispatch whole" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="p4-1" source="p4-u2" target="p4-q1" exitX="1" exitY="0.5" exitDx="0" exitDy="0" entryX="0" entryY="0.7" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e3" value="drain @ block start" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p4-1" source="p4-q1" target="p4-a2" exitX="1" exitY="0.5" exitDx="0" exitDy="0" entryX="0" entryY="0.5" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e4" value="owns" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;dashed=1;" edge="1" parent="p4-1" source="p4-a1" target="p4-a2" exitX="0.5" exitY="1" exitDx="0" exitDy="0" entryX="0.5" entryY="0" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e5" value="reduced state" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p4-1" source="p4-a2" target="p4-a3" exitX="0.5" exitY="1" exitDx="0" exitDy="0" entryX="0.5" entryY="0" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e6" value="block outputs" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p4-1" source="p4-a3" target="p4-a4" exitX="0.5" exitY="1" exitDx="0" exitDy="0" entryX="0.5" entryY="0" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e7" value="publish whole" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p4-1" source="p4-a4" target="p4-q3" exitX="0" exitY="0.5" exitDx="0" exitDy="0" entryX="1" entryY="0.5" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e8" value="render latest" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p4-1" source="p4-q3" target="p4-u3" exitX="0" exitY="0.3" exitDx="0" exitDy="0" entryX="1" entryY="0.5" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e9" value="compare ackSeq" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p4-1" source="p4-q3" target="p4-u4" exitX="0" exitY="0.7" exitDx="0" exitDy="0" entryX="1" entryY="0.5" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="scenario-compare" name="4 — Scenario comparison">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="p3-title" value="Same three scenarios — where the logic lives" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="8" width="1340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-hc" value="Classic: behavior in callbacks + protocols" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="48" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-hf" value="FRP: behavior in pure functions + declared crossings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="48" width="670" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-c1" value="&lt;b&gt;Press play&lt;/b&gt;&lt;br&gt;Handler stores an atomic or locks TransportState. The next callback — possibly mid-buffer — observes it, so the audible start depends on where in the buffer the flag was seen." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="100" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-f1" value="&lt;b&gt;Press play&lt;/b&gt;&lt;br&gt;set(playing). The next ui epoch publishes; audio reads it at a tick boundary via latest. The start beat is a pure function of the tick — bit-identical in tests." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="100" width="670" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-c2" value="&lt;b&gt;Seek while paused&lt;/b&gt;&lt;br&gt;Seek is pushed to a FIFO; the callback drains it against the paused state machine. Pause-then-seek order is defined by hand; the cursor, posted back async, can show the pre-seek position for a frame." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="304" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-f2" value="&lt;b&gt;Seek while paused&lt;/b&gt;&lt;br&gt;set(seek) is a queued event: one ui epoch, one audio epoch, and the hold jumps absolutely. The cursor follows through playhead_ui. A C++ test pins it (README §7)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="304" width="670" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-c3" value="&lt;b&gt;Note fires inside a block&lt;/b&gt;&lt;br&gt;The sequencer walks clips inside the callback, stamps sample offsets into a MidiBuffer, allocates and steals voices, smooths gain — all inside the RT deadline, none of it testable without the callback." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="508" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-f3" value="&lt;b&gt;Note fires inside a block&lt;/b&gt;&lt;br&gt;Scheduler twins compute (count, first offset) purely from the interval (prev, cur]; the gate fold and Voice hold decide sounding; the dumb player memcpys. The block math is unit-tested with no audio." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p3-1">
          <mxGeometry x="700" y="508" width="670" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3-take" value="The difference in one line — Classic: adding a wire means adding a protocol (FIFO + atomic + version + async post + flaky test). FRP: adding a wire means naming a port and a policy (latest or queued); the shell stays set / tick / get." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="712" width="1340" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
