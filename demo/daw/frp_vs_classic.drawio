          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="guarded write-back" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;dashed=1;" edge="1" parent="p2-1" source="p2-ta4" target="p2-ta1" exitX="0" exitY="0.5" exitDx="-4" exitDy="0" entryX="0" entryY="0.5" entryDx="-4" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
