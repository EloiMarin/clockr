        </mxCell>
        <mxCell id="p1-pl4" value="&lt;b&gt;The rule&lt;/b&gt;&lt;br&gt;FRP decides what/when&lt;br&gt;per block" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="1118" y="396" width="242" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-pl5" value="Pause ui loop → thick cursor freezes, thin ghost moves = latest made visible" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="p1-1">
          <mxGeometry x="1118" y="494" width="242" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p1-n1" value="Crossings are declared, not built: latest holds the most-recent-sent; queued delivers every epoch in order." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="30" y="710" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-n2" value="tick_fns are pure and total: the same network runs in tests with no threads (L1 determinism, L5 parity)." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="465" y="710" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-n3" value="One tick = one epoch per region; intra-epoch set order is unobservable (last write wins, L9a)." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="900" y="710" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-n4" value="Scope honesty — fixed network, no hosting duties: orchestration bugs are eliminated within that perimeter. Dynamic rebuilds, undo, latency compensation, and pool budgeting are still owed." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="30" y="834" width="1340" height="70" as="geometry" />
        </mxCell>
