        <mxCell id="p2-e7" value="dispatched @ block start" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p2-1" source="p2-tb1" target="p2-tc2" exitX="1" exitY="0.5" exitDx="0" exitDy="0" entryX="0" entryY="0.3" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="dispatched next block" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="p2-1" source="p2-tb2" target="p2-tc2" exitX="1" exitY="0.5" exitDx="0" exitDy="0" entryX="0" entryY="0.7" entryDx="0" entryDy="0">
