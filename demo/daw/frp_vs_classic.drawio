        <mxCell id="p1-e24" value="sample @ ui tick" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1" source="p1-cB" target="p1-ui6" exitX="0" exitY="0.5" exitDx="0" exitDy="0" entryX="1" entryY="0.5" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tracktion-impl" name="2 — Tracktion Engine (actual)">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-title" value="Tracktion Engine (actual design, develop branch) — scoped to the FRP demo's subset" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333;" vertex="1" parent="p2-1">
          <mxGeometry x="30" y="8" width="1340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-s-ui" value="Message thread — Edit + TransportControl" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p2-1">
          <mxGeometry x="30" y="48" width="280" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p2-s-plumb" value="Crossings — one protocol per field" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p2-1">
          <mxGeometry x="340" y="48" width="220" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p2-s-audio" value="Audio thread — EditPlaybackContext + node graph" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p2-1">
          <mxGeometry x="590" y="48" width="380" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p2-s-risk" value="Sharp edges, in their own comments" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;startSize=26;" vertex="1" parent="p2-1">
          <mxGeometry x="1000" y="48" width="370" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p2-ta1" value="ValueTree state — position · loopPoint1/2 · looping · playing · recording · userDragging" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="42" y="84" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-ta2" value="UI entry points — play() · stop() · setPosition() · setLoopRange() write CachedValues only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="42" y="168" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-ta3" value="Listener dispatch — valueTreePropertyChanged → performPlay / performStop / performPositionChange" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="42" y="252" width="256" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-ta4" value="50 Hz Timer heal loop — playhead → ValueTree via updatePositionFromPlayhead, guarded by updatingFromPlayHead; loop push-down; fix playing mismatches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="42" y="340" width="256" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p2-ta5" value="Fan-out — sendChangeMessage + ListenerList (video, meters, recording…)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="42" y="432" width="256" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-tb1" value="postPosition — pendingPosition + jump-time + valid flag (release-ordered atomics)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="350" y="84" width="200" height="106" as="geometry" />
        </mxCell>
        <mxCell id="p2-tb2" value="postPlay — playPending flag, dispatched next block" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="350" y="198" width="200" height="106" as="geometry" />
        </mxCell>
        <mxCell id="p2-tb3" value="Loop push-down — setLoopTimes to the playhead, every 10th timer tick" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="350" y="312" width="200" height="106" as="geometry" />
        </mxCell>
        <mxCell id="p2-tb4" value="Back: audiblePlaybackTime atomic + SyncPoint; blockUntilSyncPointChange busy-waits (1 µs sleeps, 100 ms cap)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="350" y="426" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-tc1" value="DeviceManager callback → fillNextNodeBlock → NodePlaybackContext::process" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p2-1">
          <mxGeometry x="600" y="84" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2-tc2" value="Block-start dispatch — pending position/play applied (loop-end cancels jump)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p2-1">
          <mxGeometry x="600" y="158" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-tc3" value="graph::PlayHead — sample position, loop range, roll-in-to-loop, SyncPoints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p2-1">
          <mxGeometry x="600" y="238" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-tc4" value="Rebuilt node graph — createNodeForEdit; any edit change → full rebuild (ReallocationInhibitor inhibits during drags)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p2-1">
          <mxGeometry x="600" y="318" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-tc5" value="Same subset, as nodes — tempo map · MIDI clip iterator · voice · master gain (+ thread-pool player)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p2-1">
          <mxGeometry x="600" y="406" width="360" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-td1" value="Off-by-one-block — performPlay posts the position 'otherwise… starting playback 1 block from the start'" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="1010" y="84" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-td2" value="'Order is critical' — performRecord vs the audio thread resetting roll-in-to-loop; guaranteed by comment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="1010" y="166" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-td3" value="Two positions — ValueTree getPosition() vs audible time; the header warns they differ under latency" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="1010" y="248" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-td4" value="Quantized cursor — playhead snaps to samples; the timer keeps the precisely-set position instead" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="1010" y="330" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-td5" value="Rebuild cost — structural edits reallocate the graph; drags must inhibit it explicitly" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="1010" y="412" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-td6" value="Tests forgive a block — 'offset by a block which is unavoidable' (WaveInputDevice.test)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="1010" y="494" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-m1" value="Scoped to the demo's subset on purpose: Tracktion also does recording, plugins, automation, clip slots, Ableton Link… — omitted so the examples stay comparable. Only the subset framing is invented." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="30" y="710" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-m2" value="Every crossing is still per-field plumbing (a posted atomic, a pushed range, a busy-wait) — the 'one protocol per wire' critique survives contact with the real code." style="shape=note;size=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="690" y="710" width="680" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="writes" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="p2-1" source="p2-ta2" target="p2-ta1" exitX="0.5" exitY="0" exitDx="0" exitDy="0" entryX="0.5" entryY="1" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
