        <mxCell id="p2-e2" value="listener fires" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="p2-1" source="p2-ta1" target="p2-ta3" exitX="0.5" exitY="1" exitDx="0" exitDy="0" entryX="0.5" entryY="0" entryDx="0" entryDy="0">
          <mxGeometry relative="1" as="geometry" />
